# Cloudflare Worker local secrets
# 复制为 .dev.vars 后供 `npm run dev` / workerd 使用（勿提交真实密钥）
# 生产环境请用: npx wrangler secret put ADMIN_PASSWORD / ADMIN_RECOVERY_KEY / ADMIN_SESSION_SECRET
ADMIN_PASSWORD=change-me
ADMIN_RECOVERY_KEY=replace-with-a-separate-long-random-recovery-key
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
