  },
  "dependencies": {
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.2.2",
    "wrangler": "^4.94.0"
  }
}
