# ==============================
# epic314.bucea.online - Vue3 + FastAPI 部署 (HTTPS)
# ==============================

# HTTP：自动跳转到 HTTPS
server {
    listen 80;
    server_name epic314.bucea.online;
    return 301 https://$host$request_uri;
}

# HTTPS 配置
server {
    listen 443 ssl;
    server_name epic314.bucea.online;

    # ===== SSL证书路径 =====
    # 证书由 Certbot 自动生成后会放在这个路径下
    ssl_certificate /etc/letsencrypt/live/epic314.bucea.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/epic314.bucea.online/privkey.pem;

    # 推荐的安全协议配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ===== Vue3 前端 =====
    root /var/www/epic314/dist;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ===== FastAPI 后端反向代理 =====
    location /api/ {
        client_max_body_size 100M;
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 增加超时时间，防止大文件上传时连接断开
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }

    location /protected_files/ {
        # 核心指令：设置文件在服务器上的【绝对路径】
        # 【重要】请将 /path/to/your/fastapi/files/ 替换为你的实际路径！
        alias /home/fanyuo/fastapi/files/;

        # 阻止外部用户直接访问此路径，只能通过内部重定向访问
        internal;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8000/static/;
        expires 30d; # 可选：浏览器缓存设置
    }

    location /registrations/ {
        # 假设 Flask 应用运行在 5001 端口
        # 注意末尾的斜杠，它将 /flask/ 从请求路径中移除再转发。
        proxy_pass http://127.0.0.1:5001/registrations/;

        # 标准的代理头部设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }



    # ===== 错误页面 =====
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    # ===== 日志 =====
    access_log /var/log/nginx/epic314_access.log;
    error_log  /var/log/nginx/epic314_error.log;
}