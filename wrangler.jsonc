/**
 * Cloudflare Workers + Assets
 * @see https://developers.cloudflare.com/workers/framework-guides/web-apps/vue/
 *
 * `@cloudflare/vite-plugin` injects the client assets directory at build time.
 * Do not set `assets.directory` in source config.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bucea-epic",
  "main": "server/index.ts",
  // Must not exceed the date supported by the installed workerd binary
  // (check with local `npm run dev` if Miniflare fails to start).
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "WECHAT_QR_BUCKET",
      "bucket_name": "bucea-epic-wechat-qr"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "bucea-epic-content",
      // Add the account-specific database_id after `wrangler d1 create`.
      "migrations_dir": "migrations"
    }
  ]
}
