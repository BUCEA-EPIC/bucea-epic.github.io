*.db
*.sqlite
*.sqlite3
fastapi/submissions.db
fastapi/submissions.db-journal

# 上传文件目录
fastapi/uploads/
fastapi/uploads/*

# 环境变量文件 (包含敏感信息)
.env
.env.local
.env.*.local
*.env

# 日志文件
*.log
logs/
*.log.*

