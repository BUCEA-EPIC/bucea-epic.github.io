.cache/
.parcel-cache/
.nuxt/
.next/
.output/
.turbo/

# 环境变量
.env.local
.env.*.local
.env.production
.env.development

# 编辑器配置
.vscode/
.idea/

# ==========================
# 项目特定文件 (Project Specific)
# ==========================
# 上传文件
fastapi/uploads/
!fastapi/uploads/.gitkeep

# 数据库文件
fastapi/submissions.db
fastapi/submissions.db-journal
fastapi/submissions.db-shm
fastapi/submissions.db-wal

# 构建产物
vue3/dist/
vue3/.vite/

# 临时文件
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# ==========================
# 其他 (Others)
# ==========================
# SSH 密钥
*.pem
*.key
id_rsa
id_rsa.pub
*.ppk

# 敏感配置文件
config.local.*
secrets.*
# 压缩文件
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# 文档生成
docs/_build/
site/

# 备份文件
*.bak
*.backup
*~

# ==========================
# 保留空目录 (Keep Empty Directories)
# ==========================
# 使用 .gitkeep 保留必要的空目录结构
!fastapi/uploads/.gitkeep
