# ============================================
# 314工作室官网项目 - .gitignore
# EPIC 314 Website - Git Ignore Configuration
# ============================================

# ==========================
# 操作系统文件 (OS Files)
# ==========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ==========================
# 编辑器与IDE (Editors & IDEs)
# ==========================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ==========================
# Node.js / Vue.js (前端)
# ==========================
# 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json.bak
yarn.lock.bak

# 构建输出
dist/
dist-ssr/
build/
*.local

# Vite
.vite/
.vite-ssg-manifest.json

# 测试
coverage/
.nyc_output/
*.test.js.snap

# 缓存
.cache/
.parcel-cache/
.nuxt/
.next/
.output/
.turbo/

# 环境变量
.env
.env.local
.env.*.local
.env.production
.env.development

# 编辑器配置
.vscode/
.idea/

# 临时文件
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# ==========================
# 其他 (Others)
# ==========================
# SSH 密钥
*.pem
*.key
id_rsa
id_rsa.pub
*.ppk

# 敏感配置文件
config.local.*
secrets.*

# 本地部署脚本
deploy.local.sh
deploy.*.local.sh

# 压缩文件
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# 文档生成
docs/_build/
site/

# 备份文件
*.bak
*.backup
*~
